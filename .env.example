SPRING_APPLICATION_NAME=ai-blog
SERVER_PORT=8081
SPRING_DATA_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database>?appName=<app-name>

APP_JWT_SECRET=replace-with-at-least-32-random-characters
APP_JWT_EXPIRATION_MS=86400000

APP_UPLOAD_DIR=uploads
APP_PUBLIC_URL=https://your-backend.example.com
APP_GEMINI_API_KEY=your-gemini-api-key
APP_GEMINI_MODEL=gemini-2.5-flash

APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173,https://your-frontend.vercel.app
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,https://*.vercel.app
